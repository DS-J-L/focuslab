{
  "manifest_version": 3,
  "name": "FocusLab Activity Bridge",
  "version": "0.1.0",
  "description": "Sends only the active tab's hostname (never the full URL) to the FocusLab desktop app on this PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"}
}
