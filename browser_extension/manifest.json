{
  "manifest_version": 3,
  "name": "FocusLab Activity Bridge",
  "version": "0.1.0",
  "description": "Sends the active tab hostname to FocusLab locally; optional page titles are sent only with separate consent.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
